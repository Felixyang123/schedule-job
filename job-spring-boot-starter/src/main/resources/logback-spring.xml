<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging Hardening（Spec 2026-08-06 §2.2/§2.7/§2.8）
  - prod：JSON 文件（LogstashEncoder + includeLevelValue + MDC requestId）+ AsyncAppender（日志 IO 不阻塞调度主链路）
  - dev：控制台 + 文件，人类可读文本（含 %X{requestId:-} 占位）
  - 归档：按天滚动，archive/ 目录，30 天保留，总量 10GB，单文件 500MB 分片
  - 根级别 INFO；包级级别由 application.yml 的 logging.level.* 统一管理（Spring 后处理覆盖）
-->
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="schedule-app"/>
    <property name="LOG_DIR" value="logs/${appName}"/>
    <property name="TEXT_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{requestId:-}] %logger{36} - %msg%n"/>

    <springProfile name="prod">
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <!-- 活跃文件为静态名（logback 不替换 file 中的 %d），日期体现在归档文件名 -->
            <file>${LOG_DIR}/${appName}.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/${appName}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>10GB</totalSizeCap>
                <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                    <maxFileSize>500MB</maxFileSize>
                </timeBasedFileNamingAndTriggeringPolicy>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeLevelValue>true</includeLevelValue>
            </encoder>
        </appender>

        <!-- 日志 IO 异步化：调度/派发/回调线程永不阻塞（neverBlock=true 且不丢弃） -->
        <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>8192</queueSize>
            <neverBlock>true</neverBlock>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="FILE_JSON"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${TEXT_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="FILE_DEV" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${appName}.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/${appName}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>10GB</totalSizeCap>
                <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                    <maxFileSize>500MB</maxFileSize>
                </timeBasedFileNamingAndTriggeringPolicy>
            </rollingPolicy>
            <encoder>
                <pattern>${TEXT_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_DEV"/>
        </root>
    </springProfile>
</configuration>
